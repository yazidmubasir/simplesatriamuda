/** Admin kelas scope. Owner controls MASTER_KELAS and MASTER_USERS. */
function getMyClass(){const u=requireRole_([ROLE.ADMIN_KELAS,ROLE.GURU]);return readObjects_(MASTER_SHEETS.KELAS).find(k=>String(k.id)===String(u.kelas_id))||null;}
function getMyStudents(){const u=requireRole_([ROLE.ADMIN_KELAS,ROLE.GURU]),cls=readObjects_(MASTER_SHEETS.KELAS).find(k=>String(k.id)===String(u.kelas_id));if(!cls)return[];return readObjects_(MASTER_SHEETS.SISWA).filter(s=>String(s.kelas_id)===String(cls.kode));}
function saveMyStudent(data){const u=requireRole_(ROLE.ADMIN_KELAS),cls=readObjects_(MASTER_SHEETS.KELAS).find(k=>String(k.id)===String(u.kelas_id));if(!cls)throw new Error('KELAS_NOT_FOUND');data=Object.assign({},data||{}, {kelas_id:String(cls.kode||'')});return saveMasterRow('SISWA',data);}
function deleteMyStudent(id){const u=requireRole_(ROLE.ADMIN_KELAS),cls=readObjects_(MASTER_SHEETS.KELAS).find(k=>String(k.id)===String(u.kelas_id));if(!cls)throw new Error('KELAS_NOT_FOUND');const row=readObjects_(MASTER_SHEETS.SISWA).find(s=>String(s.id)===String(id));if(!row||String(row.kelas_id)!==String(cls.kode))throw new Error('FORBIDDEN');return saveMasterRow('SISWA',{id:id,status:'NONAKTIF'});}
function getMyClassSheetData(){const u=requireRole_([ROLE.ADMIN_KELAS,ROLE.GURU,ROLE.SISWA]),cls=readObjects_(MASTER_SHEETS.KELAS).find(k=>String(k.id)===String(u.kelas_id));if(!cls)return{ok:false,rows:[]};const sh=getMasterSpreadsheet_().getSheetByName(cls.sheet_name);if(!sh||sh.getLastRow()<1)return{ok:true,headers:[],rows:[]};const values=sh.getDataRange().getDisplayValues();return{ok:true,headers:values.shift().map(parseColumnId_),rows:values};}
